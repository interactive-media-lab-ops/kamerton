{
  "name": "kamerton-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "КАМЕРТОН v0: щотижневик з памʼяттю. Дані з контракту тижня, дизайн-система Астролябія.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run check:contract && npm run check:corpus && npm run check:depth && npm run check:plots && npm run check:graviton && npm run check:new && npm run check:data && npm run check:map && npm run check:actors && npm run check:tween && npm run check:ensemble",
    "check:data": "esbuild src/data/selectors.check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/selectors.check.mjs --log-level=error && node node_modules/.cache/selectors.check.mjs",
    "check:map": "esbuild src/map/starfield.check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/starfield.check.mjs --log-level=error && node node_modules/.cache/starfield.check.mjs",
    "check:actors": "esbuild src/map/actorfield.check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/actorfield.check.mjs --log-level=error && node node_modules/.cache/actorfield.check.mjs",
    "check:tween": "esbuild src/map/galaxy.tween.check.mjs --bundle --platform=node --format=esm --loader:.webp=dataurl --outfile=node_modules/.cache/tween.check.mjs --log-level=error && node node_modules/.cache/tween.check.mjs",
    "check:ensemble": "esbuild src/data/ensemble.check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/ensemble.check.mjs --log-level=error && node node_modules/.cache/ensemble.check.mjs",
    "build:derive": "esbuild scripts/ensemble-build.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/ensemble.build.mjs --log-level=error && node node_modules/.cache/ensemble.build.mjs",
    "ensemble": "npm run build:derive",
    "check:raw-immutable": "node scripts/check-raw-immutable.mjs",
    "prebuild": "npm run build:derive && npm run build:contract && npm run build:precedents && npm run build:depth && npm run build:graviton",
    "build:precedents": "node scripts/build-precedents.mjs",
    "build:contract": "node scripts/build-contract.mjs",
    "migrate:v2": "node scripts/migrate-v2.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "migrate:g0": "node scripts/migrate-g0.mjs",
    "qa:shots": "node scripts/qa-shots.mjs",
    "qa:f3": "node scripts/f3-smoke.mjs",
    "build:import": "vite build --config vite.importer.config.js",
    "check:corpus": "node scripts/check-corpus.mjs",
    "check:depth": "node scripts/check-depth.mjs",
    "check:new": "esbuild src/data/newmodules.check.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/newmodules.check.mjs --log-level=error && node node_modules/.cache/newmodules.check.mjs",
    "migrate:f3": "esbuild scripts/migrate-f3.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/f3.mjs --log-level=error && node node_modules/.cache/f3.mjs",
    "qa:ui": "node scripts/ui-smoke.mjs",
    "check:invariants": "node scripts/check-invariants.mjs",
    "build:depth": "node scripts/build-depth.mjs",
    "build:graviton": "node scripts/build-graviton.mjs",
    "check:graviton": "node scripts/check-graviton.mjs",
    "qa:depth": "node scripts/qa-depth-shot.mjs",
    "qa:preview": "node scripts/qa-depth-preview.mjs",
    "check:plots": "node scripts/check-plots.mjs",
    "qa:plots": "node scripts/qa-plots.mjs",
    "qa:graviton": "node scripts/qa-graviton.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}
